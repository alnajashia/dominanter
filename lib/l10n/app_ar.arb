  "startForcedRemoval": "بدء الإزالة القسرية",
  "cancelForcedRemoval": "إلغاء الإزالة القسرية",
  "finishRemoval": "إنهاء الإزالة",
  "startForcedTitle": "بدء الإزالة القسرية؟",
  "startForcedBody": "يبدأ هذا عدًّا تنازليًا مدته 24 ساعة. عند انتهائه يمكن إزالة مالك الجهاز — ومعه كل قيد يفرضه هذا التطبيق — دون رمز الاسترداد. إنه المهرب الوحيد دون رمز، ويمكن إلغاؤه في أي وقت قبل اكتماله.",
  "cancelForcedTitle": "إلغاء الإزالة القسرية؟",
  "cancelForcedBody": "سيتم التخلص من العد التنازلي لـ 24 ساعة. ستتطلب إزالة مالك الجهاز رمز الاسترداد من جديد.",
  "finishForcedTitle": "إنهاء الإزالة القسرية؟",
  "finishForcedBody": "اكتمل انتظار 24 ساعة. إزالة مالك الجهاز الآن ترفع كل قيد يفرضه هذا التطبيق على هذا الجهاز.",
  "understandRemovesAll": "أفهم أن هذا يزيل كل الحماية",
  "removeDeviceOwnerAction": "إزالة مالك الجهاز",
  "deviceOwnerRemovedVerified": "تمت إزالة مالك الجهاز (تم التحقق).",
  "removalCompleteTitle": "أُزيلت الحماية بالكامل",
  "removalCompleteBody": "أُزيلت حماية عزم بالكامل: لم تبقَ أي قيود، ولا يوجد تطبيق موقوف أو مخفي بواسطة عزم، ولا شيء من عزم ما زال يعمل. يمكنك الآن إلغاء التثبيت بشكل طبيعي من إعدادات النظام.",
  "removalPartialTitle": "أُزيلت الحماية مع تنبيهات",
  "removalPartialBody": "انتهى التفكيك، لكن بعض الخطوات لم تكتمل — وهي مذكورة أدناه. أعد محاولة الإزالة بدل إلغاء التثبيت بينما قد يكون مالك الجهاز ما زال نشطًا.",
  "removalStepDisarm": "تعطيل وسائل الحماية",
  "removalStepFocus": "إيقاف وضع التركيز",
  "removalStepUnsuspend": "إلغاء إيقاف التطبيقات",
  "removalStepRestrictions": "مسح القيود",
  "removalStepUnhide": "إظهار التطبيقات",
  "removalStepUninstallBlocks": "رفع حظر إلغاء التثبيت",
  "removalStepAppRestrictions": "مسح قيود التطبيقات",
  "info_disallow_biometric": "يمنع إلغاء القفل البيومتري (البصمة/الوجه) على مستوى النظام (مفتاح سامسونج). يؤثر أيضًا على الدخول إلى عزم نفسه إن اعتمدت على دخول البصمة — استخدمه بحذر.",
  "info_disallow_camera_toggle": "يمنع مفتاح خصوصية الكاميرا (مفتاح المستشعرات في الإعدادات السريعة). يمنع تغيير حالة الكاميرا من لوحة المستشعرات.",
  "info_disallow_config_default_apps": "يمنع تغيير التطبيقات الافتراضية (المتصفح والهاتف والرسائل والمساعد). يبقي افتراضياتك الآمنة المختارة — فمثلًا يبقى متصفح مفلتر هو الافتراضي.",
  "info_disallow_config_private_dns": "يمنع تغيير إعداد DNS الخاص. مهم إذا كان ترشيحك يعتمد على محلّل DNS محدد — تغييره يعطّل المرشح بصمت. أثر جانبي: يتجمد مزوّد DNS أثناء تفعيله.",
  "info_disallow_microphone_toggle": "يمنع مفتاح خصوصية الميكروفون (مفتاح المستشعرات في سامسونج/الإعدادات السريعة). يمنع تغيير حالة الميكروفون من لوحة المستشعرات.",
  "info_ensure_verify_apps": "يفرض بقاء التحقق من التطبيقات (فحص التثبيتات بأسلوب Play Protect) مفعّلًا. يبقي شبكة أمان ضد التطبيقات الضارة؛ إيقاف الحمايات خطوة أولى شائعة في أدلة التجاوز.",
  "info_no_add_clone_profile": "يمنع إنشاء ملف مستنسخ أو تطبيقات مستنسخة (سامسونج). التطبيقات المستنسخة نسخة ثانية منفصلة قد لا تغطيها الحدود.",
  "info_no_add_managed_profile": "يمنع إنشاء ملف عمل/مُدار. قد يحمل ملف منفصل تطبيقاته غير المفلترة.",
  "info_no_add_private_profile": "يمنع إنشاء ملف/مساحة خاصة. قد تخفي المساحة الخاصة التطبيقات عن العرض الرئيسي وعن الفحوص العابرة.",
  "info_no_add_user": "يمنع إنشاء مستخدمي أندرويد جدد على الجهاز. المستخدم الثاني مساحة غير مفلترة تمامًا، لذا يغلق هذا تجاوزًا كبيرًا.",
  "info_no_add_wifi_config": "يمنع إضافة إعدادات شبكات Wi-Fi جديدة مع إبقاء الحالية قابلة للاستخدام. نسخة أخف من قفل Wi-Fi بالكامل.",
  "info_no_adjust_volume": "يمنع تغيير مستوى الصوت. يُستخدم أحيانًا لإبقاء أصوات التحذير مسموعة. أثر جانبي: تتوقف أزرار الصوت للوسائط والمكالمات.",
  "info_no_airplane_mode": "يمنع تشغيل وضع الطيران. يمنع قطع الاتصال للهروب من ترشيح الشبكة — رغم إمكانية إعادة الانضمام إلى Wi-Fi عادة. أثر جانبي: لا وضع طيران للرحلات أثناء تفعيله.",
  "info_no_ambient_display": "يمنع العرض المحيطي (شاشة اللمحة دائمة التشغيل). تحكم بسيط في سلوك العرض.",
  "info_no_assist_content": "يمنع مشاركة محتوى الشاشة مع المساعد. موجّه للخصوصية؛ يفقد المساعد سياق الشاشة.",
  "info_no_autofill": "يمنع إطار الملء التلقائي (ملء كلمات المرور/النماذج). موجّه للأمان؛ أثر جانبي: لا ملء تلقائي لكلمات المرور المحفوظة في أي مكان.",
  "info_no_bluetooth": "يمنع استخدام البلوتوث كليًا. أثر جانبي: تتوقف السماعات والساعات واتصالات السيارة.",
  "info_no_bluetooth_sharing": "يمنع مشاركة الملفات عبر البلوتوث مع إبقاء صوت البلوتوث يعمل. خيار أضيق وألطف من حظر البلوتوث بالكامل.",
  "info_no_camera": "يمنع الكاميرا بالكامل (مفتاح سامسونج). أثر جانبي: لا يمكن لأي تطبيق التقاط صور أو فيديو، بما في ذلك استخدامات بريئة مثل مسح المستندات.",
  "info_no_change_wifi_state": "يمنع تشغيل Wi-Fi أو إيقافه. مفيد عندما تكون حالة الاتصال نفسها جزءًا من الروتين. أثر جانبي: لا تبديل سريع لـ Wi-Fi من الإعدادات السريعة.",
  "info_no_config_bluetooth": "يمنع تغيير إعدادات البلوتوث (إقران أجهزة جديدة). أثر جانبي: لا يمكن إقران إكسسوارات جديدة أثناء تفعيله.",
  "info_no_config_brightness": "يمنع تغيير إعدادات سطوع الشاشة. بسيط؛ يبقي إعدادات العرض مستقرة أساسًا.",
  "info_no_config_cell_broadcasts": "يمنع تغيير إعدادات بث الخلية (تنبيهات الطوارئ). اتركه متوقفًا ما لم يكن لديك سبب محدد — تنبيهات الطوارئ مهمة.",
  "info_no_config_credentials": "يمنع تغيير بيانات الاعتماد المخزنة وتثبيت الشهادات. مهم لأن شهادة يثبّتها المستخدم قد تتيح اعتراض الحركة وتجاوز المرشح. أثر جانبي: تتجمد إعدادات شهادات العمل/المدرسة.",
  "info_no_config_date_time": "يمنع تغيير التاريخ والوقت. يحمي الحدود والجداول الزمنية من الغش بتحريك الساعة. أثر جانبي: تصحيح الوقت يدويًا متوقف؛ والوقت التلقائي يعمل.",
  "info_no_config_locale": "يمنع تغيير إعدادات لغة النظام/المنطقة. يبقي إعداد الجهاز مستقرًا.",
  "info_no_config_location": "يمنع تغيير إعدادات الموقع. يبقي السلوك المعتمد على الموقع مستقرًا؛ لا يحظر المحتوى بحد ذاته.",
  "info_no_config_mobile_networks": "يمنع تغيير إعدادات شبكة الجوال (APN ووضع الشبكة والمشغّل). مفيد لأن حيل APN قد تلتف حول ترشيح DNS. أثر جانبي: تتجمد أيضًا إعدادات التجوال والمشغّل.",
  "info_no_config_screen_timeout": "يمنع تغيير مهلة الشاشة. يبقي سلوك إطفاء الشاشة الذي اخترته؛ حماية روتينية بسيطة.",
  "info_no_config_tethering": "يمنع تغيير أي إعدادات ربط (نقطة اتصال Wi-Fi وUSB وبلوتوث). يمنع الهاتف من أن يصبح بابًا جانبيًا حول ترشيح الشبكة.",
  "info_no_config_vpn": "يمنع تغيير إعدادات VPN. مهم: قد يتجاوز VPN ترشيح DNS بالكامل، لذا قفل إعدادات VPN يحمي الإعداد كله. أثر جانبي: لا يمكنك إضافة VPN أو تبديله أثناء تفعيله.",
  "info_no_config_wifi": "يمنع تغيير إعدادات Wi-Fi: الانضمام إلى شبكات جديدة أو نسيان المحفوظة. مفيد ضد الانتقال إلى شبكة غير مفلترة. أثر جانبي: لا يمكنك الانضمام إلى شبكة Wi-Fi جديدة أثناء تفعيله.",
  "info_no_config_wifi_private": "يمنع تغيير إعداد عنوان MAC الخاص (العشوائي) لشبكة Wi-Fi (سامسونج). يبقي هوية الشبكة ثابتة لتواصل مرشحات الشبكة التعرف على الجهاز.",
  "info_no_config_wifi_shared": "يمنع تغيير خيارات إعداد Wi-Fi المشتركة (سامسونج). يمنع تعديل إعدادات الشبكة بهدوء.",
  "info_no_content_capture": "يمنع التطبيقات من التقاط محتوى الشاشة لميزات مثل المساعدات المعتمدة على اللقطات. تحكم خصوصية؛ قد يكسر بعض ميزات التحديد الذكي.",
  "info_no_content_suggestions": "يمنع اقتراحات المحتوى (الردود/الاقتراحات الذكية المستمدة من محتوى الشاشة). موجّه للخصوصية؛ بسيط.",
  "info_no_control_apps": "يمنع فتح شاشات معلومات التطبيقات حيث يمكن إيقاف التطبيقات قسرًا أو مسح بياناتها أو تغيير أذوناتها. يوقف طريق تجاوز شائعًا. أثر جانبي: لا يمكنك أيضًا إدارة تخزين التطبيقات أو أذوناتها من هناك أثناء تفعيله.",
  "info_no_create_windows": "يمنع التطبيقات من رسم نوافذ متراكبة فوق تطبيقات أخرى. يزيد الأمان ضد اختطاف اللمس، لكنه يكسر تراكبات مشروعة مثل فقاعات الدردشة وبعض أدوات إمكانية الوصول.",
  "info_no_cross_profile_copy_paste": "يمنع النسخ/اللصق بين الملفات. يوقف انتقال النصوص والروابط من الملف المضبوط إلى آخر.",
  "info_no_data_roaming": "يمنع تجوال البيانات. للتحكم في التكلفة أساسًا؛ لا يرشّح المحتوى.",
  "info_no_debugging_features": "يمنع ميزات التصحيح مثل ADB. يمنع تغيير الجهاز من كمبيوتر لتجاوز الحماية. أثر جانبي: لا يمكن للمطورين تصحيح هذا الجهاز أثناء تفعيله.",
  "info_no_factory_reset": "يمنع إعادة ضبط المصنع من الإعدادات. يحمي الإعداد كله من المسح في لحظة ضعف. هذا إعداد قوي: تبقى الاستعادة عبر مسار إزالة عزم نفسه ممكنة، لكن طريق الإعدادات مغلق.",
  "info_no_fun": "يمنع ميزات أندرويد الممتعة/بيض عيد الفصح. غير ضار وشكلي غالبًا.",
  "info_no_grant_admin": "يمنع منح حقوق مسؤول الجهاز لتطبيقات أخرى. يمنع تطبيق مسؤول آخر من التدخل في موقع عزم.",
  "info_no_install_apps": "يمنع تثبيت أي تطبيقات جديدة كليًا. مفيد عندما تريد تجميد مجموعة التطبيقات الحالية في الهاتف. أثر جانبي: حتى التطبيقات الموثوقة لا يمكن إضافتها حتى إيقاف هذا.",
  "info_no_install_unknown_sources": "يمنع تثبيت التطبيقات من خارج متجر Play (ملفات APK والمتصفحات ومديري الملفات). من أقوى وسائل الحماية ضد التطبيقات المشتتة والضارة المحمّلة جانبيًا. أثر جانبي: تُحظر أيضًا عمليات تثبيت APK المشروعة.",
  "info_no_install_unknown_sources_globally": "النسخة الشاملة من حظر المصادر غير المعروفة: تسري في كل مكان على الجهاز ولكل المستخدمين والملفات. أقوى من الإعداد لكل مصدر، وتحظر أيضًا تثبيتات APK المشروعة على مستوى الجهاز.",
  "info_no_modify_accounts": "يمنع إضافة حسابات على الجهاز أو إزالتها. قد يكون الحساب الجديد بداية جديدة تهرب من عادات مستوى التطبيق. أثر جانبي: لا يمكنك تسجيل الدخول إلى خدمات جديدة على مستوى النظام أثناء تفعيله.",
  "info_no_network_reset": "يمنع إعادة تعيين إعدادات الشبكة. قد تمسح إعادة التعيين شبكات Wi-Fi المحفوظة وحالة DNS بلمسة واحدة.",
  "info_no_non_market_app_by_knox": "يمنع التطبيقات من خارج المتاجر الرسمية على مستوى Samsung Knox. حظر Knox الخاص للتحميل الجانبي؛ قد يتداخل مع قيود المصادر غير المعروفة.",
  "info_no_outgoing_beam": "يمنع Android Beam (المشاركة بلمس NFC). قناة جانبية صغيرة لتمرير الروابط والملفات بين الهواتف.",
  "info_no_outgoing_calls": "يمنع إجراء المكالمات الصادرة. قيد ثقيل للتحكم في الاتصال؛ مكالمات الطوارئ لا يحظرها أندرويد أبدًا.",
  "info_no_physical_media": "يمنع تركيب التخزين الخارجي (بطاقات SD وأقراص USB). يغلق طريقًا لجلب محتوى غير مفلتر. أثر جانبي: لا يمكن استخدام بطاقات الذاكرة أثناء تفعيله.",
  "info_no_printing": "يمنع الطباعة من الجهاز. بسيط؛ يغلق طريقًا لتصدير المحتوى إلى ورق أو طابعات PDF.",
  "info_no_remove_managed_profile": "يمنع إزالة الملف المُدار (العمل). يبقي مساحة مُدارة حالية سليمة.",
  "info_no_remove_user": "يمنع إزالة مستخدمي أندرويد الحاليين. يبقي بنية مستخدمي الجهاز دون تغيير.",
  "info_no_safe_boot": "يمنع الإقلاع إلى الوضع الآمن. مهم: الوضع الآمن يعطّل خدمات إمكانية الوصول وإنفاذ الطرف الثالث، فهو تجاوز كلاسيكي. أثر جانبي: استكشاف الأخطاء عبر الوضع الآمن غير متاح أثناء تفعيله.",
  "info_no_set_user_icon": "يمنع تغيير صورة ملف المستخدم. قيد شكلي فقط، بلا أثر وظيفي.",
  "info_no_set_wallpaper": "يمنع تغيير الخلفية. ثبات شكلي؛ يُستخدم أحيانًا لإبقاء خلفية محفّزة في مكانها.",
  "info_no_share_location": "يمنع مشاركة موقع الجهاز مع التطبيقات. حماية للخصوصية أكثر منها مرشح محتوى.",
  "info_no_sharing_into_profile": "يمنع مشاركة المحتوى من الملف الرئيسي إلى ملف آخر. يمنع تمرير المحتوى إلى مساحة أقل ضبطًا.",
  "info_no_sim_globally": "يمنع استخدام شريحة SIM بالكامل (المكالمات وبيانات الجوال). قيد ثقيل جدًا — يفقد الهاتف خدمة الجوال أثناء تفعيله.",
  "info_no_sms": "يمنع إرسال رسائل SMS. تحكم في الاتصال؛ تطبيقات المراسلة لا تتأثر.",
  "info_no_system_error_dialogs": "يمنع مربعات أخطاء النظام (نوافذ تعطل التطبيقات). سلوك شكلي/مؤسسي؛ الأعطال تحدث، بصمت فقط.",
  "info_no_thread_network": "يمنع إنشاء شبكات Thread الحدودية أو الانضمام إليها (المنزل الذكي). متخصص؛ غير ذي صلة بمعظم الهواتف.",
  "info_no_ultra_wideband_radio": "يمنع راديو النطاق فائق الاتساع (UWB) المستخدم في أجهزة التتبع الدقيقة. تحكم متخصص في العتاد.",
  "info_no_unified_password": "يمنع فرض كلمة مرور موحدة عبر ملفي العمل والشخصي. موجّه للمؤسسات؛ غير ذي صلة بهاتف بملف واحد.",
  "info_no_uninstall_apps": "يمنع إلغاء تثبيت التطبيقات. مفيد لمنع حذف تطبيق محظور للهروب من حدوده — ولحماية إعداد عزم المرافق. أثر جانبي: لا يمكنك إزالة أي تطبيق أثناء تفعيله.",
  "info_no_unmute_microphone": "يمنع إلغاء كتم الميكروفون أثناء المكالمات. تحكم خصوصية للأجهزة المُدارة؛ نادر الصلة بالاستخدام الشخصي.",
  "info_no_usb_file_transfer": "يمنع نقل الملفات عبر USB. يمنع نقل المحتوى إلى الهاتف أو منه بالكابل. أثر جانبي: يتوقف أيضًا استيراد الصور والملفات عبر USB؛ والشحن يعمل.",
